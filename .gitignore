# Real secrets never belong in this repo — see "Secrets" in README.md.
# The store is ~/proj/x-infra/secrets/ (no git remote); .env.example carries
# placeholders only. These patterns exist so a stray copy cannot be staged.
.env
.env.*
*.env
*.env.local
*.pem
*.key
*.p12
*.pfx
auth.json

# Tracked, placeholder-only, and deliberately re-included: the broad patterns above
# would otherwise silently drop them if either file were ever deleted and recreated.
!.env.example
!.env.testing

*.log
.DS_Store
package-lock.json
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db
training_data/.codex
/.cursor/
/public/fonts-manifest.dev.json
_ide_helper.php
