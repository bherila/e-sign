# PLACEHOLDERS ONLY. Never commit a real value to this file; it is tracked and this repository
# is public. Live values belong in the untracked .env on each server.

APP_NAME="BWH eSign"
APP_ENV=local

# Generate per environment with `php artisan key:generate`. Never regenerate this against a
# populated production database: it decrypts every encrypted column and rotating it turns that
# data into unreadable ciphertext with no recovery path. APP_KEY is NOT a signing key.
APP_KEY=

APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite for local development. Production is MySQL with its own dedicated database and
# credentials; never point this application at another application's tables.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=database/database.sqlite
# DB_USERNAME=
# DB_PASSWORD=

# Sessions stay host-only (SESSION_DOMAIN=null) with a distinct cookie name. Never share a
# parent-domain session cookie, APP_KEY, or session store with the identity provider or any
# other application to obtain single sign-on; that is what the OAuth flow is for.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=esign_session
SESSION_SAME_SITE=lax
# Defaults to true when APP_ENV=production. Only set this to false on a production
# deployment that genuinely terminates TLS somewhere the browser cannot see, and understand
# that the session cookie then travels in plaintext.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

# Storage. Every document disk is private and streamed through the application. `local` is the
# cPanel default; `s3` covers any S3-compatible store (Garage, Cloudflare R2, AWS). Note that
# Garage and R2 do not provide Object Lock, so nothing here is WORM or legal hold.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mail. Production deployments use `hybrid` (Brevo API first, then the SMTP relay below) or
# `ses`; local development uses `log`. A `log` mailer never counts as delivery.
# MAILER_DSN is the Brevo API DSN, e.g. brevo+api://KEY@default; issued by Brevo, never committed.
MAIL_MAILER=log
MAILER_DSN=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="esign@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Which sign-in surface this deployment exposes.
#   auto   (default) single sign-on when an OAuth client is configured below, standalone
#          password login when it is not.
#   sso    always single sign-on; a missing setting is an outage rather than a silent
#          fall back to a password form.
#   local  always standalone password login, even where an OAuth client is configured.
# Routes are registered per mode, so run `php artisan route:clear` after changing this.
ESIGN_AUTH_MODE=auto

# Administrator single sign-on (optional). Point at an OAuth identity provider; leave blank
# for standalone local-admin mode. The client id and secret are issued by the provider. Local
# identities bind on the provider's immutable subject claim, never on email. The first person
# to log in is NOT an administrator; provision the first owner explicitly with the bootstrap
# command documented in docs/operations/bootstrap.md.
# The issuer key stored on every identity binding and the exact value --issuer must be
# given. Required for SSO mode; leave blank for a standalone installation.
OAUTH_PROVIDER=
OAUTH_PROVIDER_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI="${APP_URL}/auth/callback"

# Authentication audit trail and password-login lockout, both from bherila/auth-laravel and
# both backed by the `auth_audit_log` table. The defaults in config/bherila-auth.php enable
# them; these are here to be turned down, not up. Behind a proxy, configure Laravel's trusted
# proxies as well or every request resolves to the proxy's address.
# BHERILA_AUTH_AUDIT_DRIVER=database
# BHERILA_AUTH_THROTTLE_ENABLED=true
# BHERILA_AUTH_THROTTLE_MAX_ATTEMPTS=5
# BHERILA_AUTH_THROTTLE_DECAY_MINUTES=15
# BHERILA_AUTH_THROTTLE_KEY=email_ip

# Document sealing (Stage 3). The service seal certificate and private key are versioned key
# material kept outside the repository, image layers, document storage, and logs. In Docker,
# mount them only into the worker role. Leave blank until the sealing pipeline exists.
ESIGN_SEAL_KEY_ID=
ESIGN_SEAL_CERTIFICATE_PATH=
ESIGN_SEAL_PRIVATE_KEY_PATH=
ESIGN_SEAL_PRIVATE_KEY_PASSPHRASE=
# Optional PEM bundle with the chain above the seal certificate, leaf first. A self-issued
# seal has no chain to add; see docs/adr/0003-seal-material-and-timestamp-authority.md.
ESIGN_SEAL_CHAIN_PATH=
# CMS digest algorithm: sha256, sha384, or sha512. SHA-1 is not offered.
ESIGN_SEAL_DIGEST_ALGORITHM=sha256
# RFC 3161 timestamp authority for PAdES B-T. Blank means B-B only; a configured but failing
# TSA is an error, never a silent downgrade. Example: https://freetsa.org/tsr
ESIGN_TSA_URL=
ESIGN_TSA_TIMEOUT=15
# Some public TSAs publish RFC 3161 over plaintext HTTP only. The token is signed and
# nonce-matched either way, but the document digest then travels in the clear.
ESIGN_TSA_ALLOW_PLAINTEXT_HTTP=false
# Accept a timestamp token that names its certificate with the SHA-1 RFC 2634
# signing-certificate (v1) attribute. Relaxes the token check only.
ESIGN_TSA_ALLOW_SHA1_TOKEN=false

# Health and readiness (Stage 1). The detailed /health/ready body is only returned to a
# caller that presents this bearer token or connects from an allowlisted CIDR; everyone
# else gets the HTTP status code and nothing else. Leave the token blank in development.
ESIGN_HEALTH_TOKEN=
ESIGN_HEALTH_ALLOW_CIDRS=127.0.0.1/32,::1/128

VITE_APP_NAME="${APP_NAME}"
