# PLACEHOLDERS ONLY. Never commit a real value to this file; it is tracked and this repository
# is public. Live values belong in the untracked .env on each server.

APP_NAME="BWH eSign"
APP_ENV=local

# Generate per environment with `php artisan key:generate`. Never regenerate this against a
# populated production database: it decrypts every encrypted column and rotating it turns that
# data into unreadable ciphertext with no recovery path. APP_KEY is NOT a signing key.
APP_KEY=

APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite for local development. Production is MySQL with its own dedicated database and
# credentials; never point this application at another application's tables.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=database/database.sqlite
# DB_USERNAME=
# DB_PASSWORD=

# Sessions stay host-only (SESSION_DOMAIN=null) with a distinct cookie name. Never share a
# parent-domain session cookie, APP_KEY, or session store with the identity provider or any
# other application to obtain single sign-on; that is what the OAuth flow is for.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=esign_session
SESSION_SAME_SITE=lax
# Defaults to true when APP_ENV=production. Only set this to false on a production
# deployment that genuinely terminates TLS somewhere the browser cannot see, and understand
# that the session cookie then travels in plaintext.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

# Storage. Every document disk is private and streamed through the application. `local` is the
# cPanel default; `s3` covers any S3-compatible store (Garage, Cloudflare R2, AWS). Note that
# Garage and R2 do not provide Object Lock, so nothing here is WORM or legal hold.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Document storage (Stage 2). Uploaded originals, review revisions, and every later artifact
# live on the `documents` disk. `local` keeps them under storage/app/documents, which the
# deploy workflow already excludes from its rsync --delete; `s3` puts them in the bucket
# below. Either way they are private, never presigned, and always streamed through the app.
# ESIGN_DOCUMENTS_* credentials fall back to the AWS_* values above when unset, so a single
# bucket deployment does not have to repeat them.
ESIGN_DOCUMENTS_DRIVER=local
ESIGN_DOCUMENTS_PREFIX=
# ESIGN_DOCUMENTS_AWS_ACCESS_KEY_ID=
# ESIGN_DOCUMENTS_AWS_SECRET_ACCESS_KEY=
# ESIGN_DOCUMENTS_AWS_DEFAULT_REGION=
# ESIGN_DOCUMENTS_AWS_BUCKET=
# ESIGN_DOCUMENTS_AWS_ENDPOINT=
# ESIGN_DOCUMENTS_AWS_USE_PATH_STYLE_ENDPOINT=

# Upload and preflight ceilings, enforced by both the upload Form Request and the PDF
# parser. Defaults come from the measured cost table in docs/stage0/pdf-import.md.
ESIGN_DOCUMENTS_MAX_BYTES=33554432
ESIGN_DOCUMENTS_MAX_PAGES=500
ESIGN_DOCUMENTS_MAX_OBJECTS=100000
ESIGN_DOCUMENTS_MAX_DECODED_STREAM_BYTES=33554432
# Rebuild every accepted PDF through the importer before review. Off by default: the current
# importer drops annotations and /UserUnit, so rebuilding a document that needs nothing done
# to it loses content. See docs/preparation/documents.md before turning this on.
ESIGN_DOCUMENTS_NORMALIZE_REBUILD_PAGES=false

# The consent policy version a new template version records when the caller does not name
# one. Each template version snapshots it, so the attestation can say which consent text the
# signer was shown even after this has moved on; changing it affects versions published after
# the change and nothing else. See docs/preparation/templates.md.
ESIGN_CONSENT_POLICY_VERSION=2026-09-01

# Prefill variables the sending context can resolve, comma separated, offered and validated by
# the visual field editor. Empty by default: a template has no sending context, so the editor
# skips the resolvability check and says so rather than rejecting every prefill. Naming a set
# here moves that check from send time to draft time. See docs/preparation/editor.md.
ESIGN_PREFILL_VARIABLES=

# Mail. Production deployments use `hybrid` (Brevo API first, then the SMTP relay below) or
# `ses`; local development uses `log`. A `log` mailer never counts as delivery.
# MAILER_DSN is the Brevo API DSN, e.g. brevo+api://KEY@default; issued by Brevo, never committed.
MAIL_MAILER=log
MAILER_DSN=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="esign@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Signing lifecycle timing (issues #34, #35). Both are measured from a fact on the recipient
# row, not from when the scheduler last ran, so an extra run of esign:signing:remind sends
# nothing extra. See docs/delivery/envelope-events.md.
ESIGN_SIGNING_REMINDER_AFTER_HOURS=72
ESIGN_SIGNING_REMINDER_INTERVAL_HOURS=24

# Outbound mail outbox (issue #35). Retries and the retry pause, in seconds, per message.
ESIGN_MAIL_TRIES=5
ESIGN_MAIL_BACKOFF=60,300,900,3600
ESIGN_MAIL_QUEUE=mail

# Shared token Brevo must present on POST /webhooks/mail/brevo (Brevo signs nothing).
# Empty disables the endpoint. Generate with: php -r "echo bin2hex(random_bytes(32));"
ESIGN_MAIL_BREVO_WEBHOOK_TOKEN=

# SNS topic that carries SES bounce/complaint/delivery feedback. The endpoint also requires
# a signature verifier, which is not implemented: it rejects every message until one is.
ESIGN_MAIL_SES_TOPIC_ARN=

# mail_backlog readiness thresholds: age of the oldest queued message, and failures in 24h.
ESIGN_MAIL_BACKLOG_WARN_SECONDS=300
ESIGN_MAIL_BACKLOG_FAIL_SECONDS=1800
ESIGN_MAIL_FAILED_WARN_COUNT=1
ESIGN_MAIL_FAILED_FAIL_COUNT=25

# Which sign-in surface this deployment exposes.
#   auto   (default) single sign-on when an OAuth client is configured below, standalone
#          password login when it is not.
#   sso    always single sign-on; a missing setting is an outage rather than a silent
#          fall back to a password form.
#   local  always standalone password login, even where an OAuth client is configured.
# Routes are registered per mode, so run `php artisan route:clear` after changing this.
ESIGN_AUTH_MODE=auto

# Administrator single sign-on (optional). Point at an OAuth identity provider; leave blank
# for standalone local-admin mode. The client id and secret are issued by the provider. Local
# identities bind on the provider's immutable subject claim, never on email. The first person
# to log in is NOT an administrator; provision the first owner explicitly with the bootstrap
# command documented in docs/operations/bootstrap.md.
# The issuer key stored on every identity binding and the exact value --issuer must be
# given. Required for SSO mode; leave blank for a standalone installation.
OAUTH_PROVIDER=
OAUTH_PROVIDER_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI="${APP_URL}/auth/callback"

# Authentication audit trail and password-login lockout, both from bherila/auth-laravel and
# both backed by the `auth_audit_log` table. The defaults in config/bherila-auth.php enable
# them; these are here to be turned down, not up. Behind a proxy, configure Laravel's trusted
# proxies as well or every request resolves to the proxy's address.
# BHERILA_AUTH_AUDIT_DRIVER=database
# BHERILA_AUTH_THROTTLE_ENABLED=true
# BHERILA_AUTH_THROTTLE_MAX_ATTEMPTS=5
# BHERILA_AUTH_THROTTLE_DECAY_MINUTES=15
# BHERILA_AUTH_THROTTLE_KEY=email_ip

# Document sealing (Stage 3). The service seal certificate and private key are versioned key
# material kept outside the repository, image layers, document storage, and logs. In Docker,
# mount them only into the worker role. Leave blank until the sealing pipeline exists.
ESIGN_SEAL_KEY_ID=
ESIGN_SEAL_CERTIFICATE_PATH=
ESIGN_SEAL_PRIVATE_KEY_PATH=
ESIGN_SEAL_PRIVATE_KEY_PASSPHRASE=
# Optional PEM bundle with the chain above the seal certificate, leaf first. A self-issued
# seal has no chain to add; see docs/adr/0003-seal-material-and-timestamp-authority.md.
ESIGN_SEAL_CHAIN_PATH=
# CMS digest algorithm: sha256, sha384, or sha512. SHA-1 is not offered.
ESIGN_SEAL_DIGEST_ALGORITHM=sha256
# RFC 3161 timestamp authority for PAdES B-T. Blank means B-B only; a configured but failing
# TSA is an error, never a silent downgrade. Example: https://freetsa.org/tsr
ESIGN_TSA_URL=
ESIGN_TSA_TIMEOUT=15
# Some public TSAs publish RFC 3161 over plaintext HTTP only. The token is signed and
# nonce-matched either way, but the document digest then travels in the clear.
ESIGN_TSA_ALLOW_PLAINTEXT_HTTP=false
# Accept a timestamp token that names its certificate with the SHA-1 RFC 2634
# signing-certificate (v1) attribute. Relaxes the token check only.
ESIGN_TSA_ALLOW_SHA1_TOKEN=false

# Health and readiness (Stage 1). The detailed /health/ready body is only returned to a
# caller that presents this bearer token or connects from an allowlisted CIDR; everyone
# else gets the HTTP status code and nothing else. Leave the token blank in development.
ESIGN_HEALTH_TOKEN=
ESIGN_HEALTH_ALLOW_CIDRS=127.0.0.1/32,::1/128

# Webhook delivery (Stage 4). Every outbound destination — webhook endpoints and the TSA —
# must be HTTPS and must not resolve to a private, loopback, link-local, or reserved
# address. The allowlist below is the only exception and it is deployment configuration, not
# something a workspace administrator can set: comma-separated `host-or-cidr|private|plaintext`
# entries, e.g. ESIGN_DELIVERY_ALLOWLIST="consumer.internal.example|private|plaintext"
ESIGN_DELIVERY_ALLOWLIST=
# Response deadline for one delivery attempt, in seconds.
ESIGN_WEBHOOK_TIMEOUT=5
ESIGN_WEBHOOK_CONNECT_TIMEOUT=5
ESIGN_WEBHOOK_QUEUE=default
# Backoff after attempt 1, 2, … in seconds. Seven attempts over ~40h by default.
ESIGN_WEBHOOK_RETRY_DELAYS=60,300,1800,7200,43200,86400
ESIGN_WEBHOOK_RETRY_JITTER=0.1
# Consecutive undeliverable events before an endpoint is auto-disabled with a visible reason.
ESIGN_WEBHOOK_AUTO_DISABLE_AFTER=10
# How long a rotated-out signing secret keeps signing alongside the new one, in hours.
ESIGN_WEBHOOK_ROTATION_GRACE_HOURS=168
# Age of the oldest overdue delivery, in seconds, at which readiness warns and then fails.
ESIGN_WEBHOOK_BACKLOG_WARN_SECONDS=300
ESIGN_WEBHOOK_BACKLOG_FAIL_SECONDS=1800

# Guest signing access (Stage 3, issues #25 and #26). Recipients are not application users:
# they hold one opaque invitation credential, exchange it for a scoped session in an explicit
# POST, and act only inside that session. See docs/signing/guest-access.md.
ESIGN_SIGNING_INVITATION_TTL_HOURS=168
ESIGN_SIGNING_SESSION_TTL_MINUTES=120
# Mailbox OTP on top of the link. A workspace, and then an individual envelope, may override
# this. An emailed code demonstrates continued access to the same mailbox the link went to:
# a second check on one factor, not a second factor, and never a qualified signature.
ESIGN_SIGNING_REQUIRE_OTP=false
ESIGN_SIGNING_OTP_TTL_MINUTES=10
ESIGN_SIGNING_OTP_MAX_ATTEMPTS=5
ESIGN_SIGNING_OTP_PER_ADDRESS_PER_HOUR=5
ESIGN_SIGNING_OTP_PER_IP_PER_HOUR=20
ESIGN_SIGNING_OTP_VERIFY_PER_IP_PER_HOUR=30
ESIGN_SIGNING_START_PER_IP_PER_HOUR=30
# Captured signature images are decoded with GD, measured, and re-encoded as PNG before they
# are stored. SVG, HTML, and remote URLs are refused rather than sanitized.
ESIGN_SIGNING_MAX_SIGNATURE_IMAGE_BYTES=204800
ESIGN_SIGNING_MAX_SIGNATURE_IMAGE_WIDTH=2000
ESIGN_SIGNING_MAX_SIGNATURE_IMAGE_HEIGHT=800
# Hosts a `?return=` destination may point at, comma separated. Empty means no return
# destination is ever honoured; an unlisted one is ignored, never reflected.
ESIGN_SIGNING_RETURN_URL_ALLOWLIST=

# Retention, legal hold, and deletion (Stage 5, issue #40). Three policies, deliberately
# separate; see docs/operations/retention.md. A legal hold on an envelope overrides all of
# them, and nothing here deletes anything until `esign:retention:run` is invoked.
ESIGN_RETENTION_AUTH_LOGS_DAYS=400
ESIGN_RETENTION_ABANDONED_DRAFTS_DAYS=90
# Executed agreements. LEAVE THIS BLANK unless an operator has reviewed a retention window
# against the jurisdictions the agreements were signed under and whatever the counterparties
# agreed contractually. Blank, 0, and negative all mean "never delete automatically", which
# is the shipped default and the safe answer. Setting it is a decision to destroy signed
# agreements on a schedule.
ESIGN_RETENTION_EXECUTED_DOCUMENTS_DAYS=
# How long a soft-deleted envelope keeps its bytes before `esign:retention:purge-blobs` may
# remove them. The window in which a retention decision made in error is still one UPDATE
# away from being undone.
ESIGN_RETENTION_PURGE_GRACE_DAYS=30
# Age at which the artifact_integrity readiness probe stops trusting the last
# `esign:artifacts:verify` run. Eight, because routes/console.php runs it weekly.
ESIGN_RETENTION_VERIFICATION_WARN_DAYS=8
# Where `esign:backup:manifest` writes and `esign:restore:verify` reads, if --path/--manifest
# is not given. Relative paths resolve against the application base path.
ESIGN_BACKUP_MANIFEST_PATH=storage/app/backups/manifest.json

# Restore drill. Set to 1 ONLY in the throwaway environment a backup is restored into. It
# makes `esign:restore:verify` runnable and makes MailOutbox, OutboundMailSender, and the
# webhook dispatcher refuse to send: a restored copy holds real recipient addresses and real
# endpoint URLs, with queued work against both, and nothing in the data tells it that it is a
# copy. See docs/operations/backups.md. Never set this on an instance serving traffic.
ESIGN_RESTORE_DRILL=false

VITE_APP_NAME="${APP_NAME}"
